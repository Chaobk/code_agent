# 复制为 .env 后填入你自己的密钥(.env 已被 .gitignore 忽略,不会入库)
DEEPSEEK_API_KEY=sk-your-key-here

# 以下为可选覆盖项,默认值见 src/code_agent/config.py
# CODE_AGENT_MODEL=deepseek-chat
# CODE_AGENT_BASE_URL=https://api.deepseek.com
# CODE_AGENT_MAX_STEPS=30

# 模型请求的 HTTP 等待超时，单位秒；不包含工具执行，也不是整次任务总时限
# CODE_AGENT_REQUEST_TIMEOUT_SECONDS=60

# Bash 执行环境;工作目录默认使用启动程序时的当前目录
# CODE_AGENT_WORKSPACE_DIR=C:/path/to/your/project
# CODE_AGENT_BASH_PATH=bash
# Windows 若 PATH 中没有 Bash,可指定 Git Bash 的实际安装路径:
# CODE_AGENT_BASH_PATH=C:/Program Files/Git/bin/bash.exe
